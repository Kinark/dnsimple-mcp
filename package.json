{
  "name": "dnsimple-mcp",
  "version": "0.1.0",
  "description": "MCP server for DNSimple that wraps the official dnsimple CLI and authenticates with its browser OAuth flow — no API tokens.",
  "type": "module",
  "bin": {
    "dnsimple-mcp": "bin/dnsimple-mcp.js"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/dnsimple-mcp.js",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "dnsimple",
    "dns",
    "oauth",
    "model-context-protocol"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kinark/dnsimple-mcp.git"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  }
}
